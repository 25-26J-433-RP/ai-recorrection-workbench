{
  "info": {
    "name": "Akura AI - Dyslexia Correction API",
    "description": "API collection for Akura AI Sinhala dyslexic word correction © 2025",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "childId",
      "value": "child123",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/health",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "health"]
        },
        "description": "Check API and Ollama connection status"
      }
    },
    {
      "name": "Analyze Text",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"text\": \"මම ඉස්කොලෙට යනව. මකෙ පසල ලොකුඉ.\",\n  \"include_correct_words\": false\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/analyze",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "analyze"]
        },
        "description": "Analyze Sinhala text for dyslexic writing errors"
      }
    },
    {
      "name": "Get Patterns",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/patterns",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "patterns"]
        },
        "description": "Get available dyslexia pattern types"
      }
    },
    {
      "name": "Child Essays",
      "item": [
        {
          "name": "Submit Essay for Child",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"original_text\": \"මම ගෙරද යනව. මගේ අම්මා හරි හොදයි.\",\n  \"title\": \"My Home Essay\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/children/{{childId}}/essays",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "children", "{{childId}}", "essays"]
            },
            "description": "Submit an essay for a child and get the corrected version"
          }
        },
        {
          "name": "Get All Child Essays",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/children/{{childId}}/essays",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "children", "{{childId}}", "essays"]
            },
            "description": "Get all corrected essays for a specific child"
          }
        },
        {
          "name": "Get Latest Essay",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/children/{{childId}}/essays/latest",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "children", "{{childId}}", "essays", "latest"]
            },
            "description": "Get the most recent corrected essay for a child"
          }
        },
        {
          "name": "Get Specific Essay",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/children/{{childId}}/essays/:essayId",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "children", "{{childId}}", "essays", ":essayId"],
              "variable": [
                {"key": "essayId", "value": "essay-uuid-here"}
              ]
            },
            "description": "Get a specific essay by ID"
          }
        },
        {
          "name": "Delete Essay",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/children/{{childId}}/essays/:essayId",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "children", "{{childId}}", "essays", ":essayId"],
              "variable": [
                {"key": "essayId", "value": "essay-uuid-here"}
              ]
            },
            "description": "Delete a specific essay"
          }
        },
        {
          "name": "List All Children",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/children",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "children"]
            },
            "description": "List all children who have submitted essays"
          }
        }
      ]
    },
    {
      "name": "Sessions (Teacher Feedback)",
      "item": [
        {
          "name": "Create Session",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"original_text\": \"මම ඉස්කොලෙට යනව.\",\n  \"model_used\": \"akura_llama_8b\",\n  \"corrections\": [\n    {\n      \"original_word\": \"ඉස්කොලෙට\",\n      \"suggested_word\": \"ඉස්කෝලේට\",\n      \"pattern\": \"Spelling\",\n      \"confidence\": 0.9\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/sessions",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "sessions"]
            },
            "description": "Create a new correction session"
          }
        },
        {
          "name": "List Sessions",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/sessions?limit=50&offset=0",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "sessions"],
              "query": [
                {"key": "limit", "value": "50"},
                {"key": "offset", "value": "0"}
              ]
            },
            "description": "List all correction sessions"
          }
        },
        {
          "name": "Export Training Data",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/sessions/export/training-data",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "sessions", "export", "training-data"]
            },
            "description": "Export completed sessions as training data for fine-tuning"
          }
        }
      ]
    }
  ]
}

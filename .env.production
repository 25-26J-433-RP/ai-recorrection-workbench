# Akura AI - Production Environment Configuration
# Copy to .env and fill in values before deploying

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=false
ENVIRONMENT=production

# LLM Provider (ollama)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://20.212.24.114:11434
OLLAMA_MODEL=hf.co/hasinduOnline/akura_ai_sinhala_dyslexic_word_corrector_4bit:Q4_K_M
OLLAMA_TIMEOUT=300

# Dual Model Pipeline
ENABLE_DUAL_MODEL=true
SECONDARY_OLLAMA_MODEL=gemini-3-flash-preview:latest
SECONDARY_OLLAMA_TIMEOUT=300
SECONDARY_OLLAMA_TEMPERATURE=0.3

# Model Parameters
MODEL_TEMPERATURE=0.3
MODEL_MAX_TOKENS=2048
AI_CONFIDENCE_THRESHOLD=0.7

# OCR (Google Gemini Vision API - optional)
# GEMINI_API_KEY=your-google-api-key
# GEMINI_MODEL=gemini-2.0-flash

# Firebase (optional)
# FIREBASE_CREDENTIALS_PATH=/path/to/firebase-credentials.json

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# CORS (restrict in production)
ALLOWED_ORIGINS=*

# MongoDB (if used)
# MONGODB_URL=mongodb://localhost:27017
# MONGODB_DB_NAME=akura_ai
